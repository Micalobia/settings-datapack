{
    "title": "Settings",
    "external_title": { "text": "Settings...", "color": "#2aa198", "shadow_color": [0.04, 0.16, 0.15, 0.8] },
    "type": "multi_action",
    "body": [
        {
            "type": "minecraft:plain_message",
            "contents": "Open the settings menu?"
        }
    ],
    "can_close_with_escape": true,
    "pause": false,
    "after_action": "none",
    "columns": 1,
    "actions": [
        {
            "label": "Open Settings",
            "action": {
                "type": "run_command",
                "command": "trigger Settings"
            }
        },
        {
            "label": "Cancel",
            "action": {
                "type": "run_command",
                "command": "trigger Settings set -1"
            }
        }
    ],
    "exit_action": {
        "label": "Cancel"
    }
}
